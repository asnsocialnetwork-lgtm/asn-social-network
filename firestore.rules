            )
          );
        allow delete: if isValidId(pageId) && isValidId(inviteeId)
          && isAuthenticatedActive()
          && canManagePageMembers(pageId, getPageDoc(pageId));
      }

      match /audit_logs/{logId} {
        allow get: if isValidId(pageId) && isValidId(logId) && isSignedIn();
        allow list: if isValidId(pageId) && isSignedIn() && resource.data.pageId == pageId;
        allow create: if isValidId(pageId) && isValidId(logId)
          && isAuthenticatedActive()
          && isValidPageAuditLog(incoming())
          && incoming().pageId == pageId
          && incoming().actorId == request.auth.uid
          && incoming().createdAt == request.time
          && (
            canManagePageMembers(pageId, getPageDoc(pageId)) ||
            (incoming().action in ['invite_accepted', 'invite_declined'] && incoming().targetUserId == request.auth.uid)
          );
        allow update, delete: if false;
      }

      match /notifications/{notifId} {
        allow get: if isValidId(pageId) && isValidId(notifId) && isSignedIn();
        allow list: if isValidId(pageId) && isSignedIn() && resource.data.pageId == pageId;
        allow create: if isValidId(pageId) && isValidId(notifId)
          && isAuthenticatedActive()
          && isValidPageNotification(incoming())
          && incoming().pageId == pageId
          && incoming().actorId == request.auth.uid
          && incoming().read == false
          && incoming().createdAt == request.time;
        allow update: if isValidId(pageId) && isValidId(notifId)
          && isAuthenticatedActive()
          && isValidPageNotification(incoming())
          && incoming().diff(existing()).affectedKeys().hasOnly(['read'])
          && isPageActiveMemberOrOwner(pageId, getPageDoc(pageId));
        allow delete: if isValidId(pageId) && isValidId(notifId) && isSignedIn() && (
          isAdmin() || canEditPageSettings(pageId, getPageDoc(pageId))
        );
      }

      match /reports/{reportId} {
        allow get: if isValidId(pageId) && isValidId(reportId) && isSignedIn();
        allow list: if isValidId(pageId) && isSignedIn() && resource.data.pageId == pageId;
        allow create: if isValidId(pageId) && isValidId(reportId)
          && canAct()
          && isValidPageReport(incoming())
          && incoming().pageId == pageId
          && incoming().reporterId == request.auth.uid
          && incoming().status == 'open'
          && incoming().moderatorAction == ''
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(pageId) && isValidId(reportId)
          && isAuthenticatedActive()
          && isValidPageReport(incoming())
          && existing().status == 'open'
          && incoming().status in ['resolved', 'dismissed']
          && incoming().pageId == existing().pageId
          && incoming().reporterId == existing().reporterId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && canModeratePageComments(pageId, getPageDoc(pageId));
        allow delete: if isValidId(pageId) && isValidId(reportId) && isAdmin();
      }
    }

    match /groups/{groupId} {
      allow get: if isValidId(groupId) && isSignedIn() && (resource == null || existing().status == 'active' || existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.status == 'active' || resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isValidId(groupId)
        && canAct()
        && isValidGroup(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().membersCount == 1
        && incoming().status == 'active'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
      allow update: if isValidId(groupId) && isSignedIn() && isValidGroup(incoming()) && (
        isAdmin() ||
        (
          canAct()
          && existing().status == 'active'
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (existing().ownerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'description', 'privacy', 'coverURL', 'updatedAt'])) ||
            (incoming().diff(existing()).affectedKeys().hasOnly(['membersCount', 'updatedAt']) && (
              (incoming().membersCount == existing().membersCount + 1 && existsAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))) ||
              (incoming().membersCount == existing().membersCount - 1 && !existsAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)))
            ))
          )
        )
      );
      allow delete: if isValidId(groupId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());

      match /members/{userId} {
        allow get: if isValidId(groupId) && isValidId(userId) && isSignedIn();
        allow list: if isValidId(groupId) && isSignedIn();
        allow create: if isValidId(groupId) && isValidId(userId)
          && canAct()
          && request.auth.uid == userId
          && isValidGroupMember(incoming())
          && incoming().userId == request.auth.uid
          && incoming().joinedAt == request.time
          && (
            (incoming().role == 'owner' && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid) ||
            (incoming().role == 'member' && exists(/databases/$(database)/documents/groups/$(groupId)) && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.membersCount == get(/databases/$(database)/documents/groups/$(groupId)).data.membersCount + 1)
          );
        allow delete: if isValidId(groupId) && isValidId(userId)
          && canAct()
          && request.auth.uid == userId
          && existing().role != 'owner'
          && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.membersCount == get(/databases/$(database)/documents/groups/$(groupId)).data.membersCount - 1;
      }
    }

    match /conversations/{conversationId} {
      allow get: if isValidId(conversationId) && isSignedIn() && (resource == null || request.auth.uid in existing().participantIds);
      allow list: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isValidId(conversationId)
        && canAct()
        && isValidConversation(incoming())
        && request.auth.uid in incoming().participantIds
        && (
          !('isGroup' in incoming())
          || incoming().isGroup == false
          || (
            incoming().isGroup == true
            && 'adminId' in incoming()
            && incoming().adminId == request.auth.uid
            && 'groupName' in incoming()
          )
        )
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().lastMessageAt == request.time;
      allow update: if isValidId(conversationId)
        && canAct()
        && isValidConversation(incoming())
        && request.auth.uid in existing().participantIds
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            incoming().participantIds == existing().participantIds
            && incoming().lastMessageAt == request.time
            && incoming().lastSenderId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'lastSenderId', 'lastMessageAt', 'updatedAt'])
          ) ||
          (
            'isGroup' in existing()
            && existing().isGroup == true
            && 'adminId' in existing()
            && existing().adminId == request.auth.uid
            && request.auth.uid in incoming().participantIds
            && incoming().isGroup == existing().isGroup
            && incoming().adminId == existing().adminId
            && incoming().diff(existing()).affectedKeys().hasOnly(['groupName', 'participantIds', 'participantProfiles', 'updatedAt'])
          )
        );

      match /messages/{messageId} {
        allow get: if isValidId(conversationId) && isValidId(messageId)
          && isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow list: if isValidId(conversationId)
          && isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if isValidId(conversationId) && isValidId(messageId)
          && canAct()
          && isValidDirectMessage(incoming())
          && incoming().senderId == request.auth.uid
          && incoming().createdAt == request.time
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow delete: if isValidId(conversationId) && isValidId(messageId)
          && isSignedIn()
          && existing().senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
      }
    }

    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isSignedIn() && (resource == null || existing().recipientId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if isValidId(notificationId)
        && isAuthenticatedActive()
        && isValidNotification(incoming())
        && incoming().actorId == request.auth.uid
        && incoming().read == false
        && incoming().createdAt == request.time;
      allow update: if isValidId(notificationId)
        && isSignedIn()
        && isValidNotification(incoming())
        && existing().recipientId == request.auth.uid
        && incoming().recipientId == existing().recipientId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isValidId(notificationId) && isSignedIn() && existing().recipientId == request.auth.uid;
    }

    match /monetization_applications/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(userId)
        && canAct()
        && isOwner(userId)
        && isValidMonetizationApp(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().adminNote == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isAdmin() && isValidMonetizationApp(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /payout_requests/{requestId} {
      allow get: if isValidId(requestId) && isSignedIn() && (resource == null || existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(requestId)
        && canAct()
        && isValidPayoutRequest(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().adminNote == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && get(/databases/$(database)/documents/users_public/$(request.auth.uid)).data.monetizationStatus == 'approved'
        && incoming().amountCents <= get(/databases/$(database)/documents/users_private/$(request.auth.uid)).data.totalEarningsCents;
      allow update: if isValidId(requestId) && isAdmin() && isValidPayoutRequest(incoming())
        && existing().status in ['pending', 'approved']
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(requestId) && isAdmin();
    }

    match /reports/{reportId} {
      allow get: if isValidId(reportId) && isSignedIn() && (resource == null || existing().reporterId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow create: if isValidId(reportId)
        && canAct()
        && isValidReport(incoming())
        && incoming().reporterId == request.auth.uid
        && incoming().status == 'open'
        && incoming().adminAction == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(reportId) && isAdmin() && isValidReport(incoming())
        && existing().status == 'open'
        && incoming().reporterId == existing().reporterId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(reportId) && isAdmin();
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isAdmin() && isValidAdminRecord(incoming()) && incoming().createdAt == request.time;
      allow delete: if isValidId(userId) && isAdmin() && userId != request.auth.uid;
    }

    match /platform_config/{configId} {
      allow get: if isValidId(configId) && isSignedIn();
      allow list: if isSignedIn() && resource.data.maintenanceMode is bool;
      allow create, update: if isValidId(configId) && isAdmin() && isValidPlatformConfig(incoming()) && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /stories/{storyId} {
      allow get: if isValidId(storyId) && isSignedIn() && (resource == null || existing().status == 'active' || existing().authorId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.status == 'active' || resource.data.authorId == request.auth.uid || isAdmin());
      allow create: if isValidId(storyId)
        && canAct()
        && isValidStory(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().viewsCount == 0
        && incoming().status == 'active'
        && incoming().createdAt == request.time
        && incoming().expiresAt > request.time
        && (
          (incoming().contextType == 'personal' && incoming().contextId == '') ||
          (
            incoming().contextType == 'page'
            && isValidId(incoming().contextId)
            && exists(/databases/$(database)/documents/pages/$(incoming().contextId))
            && canPublishPageContent(incoming().contextId, getPageDoc(incoming().contextId))
          )
        );
      allow update: if isValidId(storyId) && isSignedIn() && isValidStory(incoming()) && (
        isAdmin() ||
        (
          canAct()
          && existing().status == 'active'
          && incoming().authorId == existing().authorId
          && incoming().createdAt == existing().createdAt
          && incoming().expiresAt == existing().expiresAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount'])
          && incoming().viewsCount == existing().viewsCount + 1
          && existsAfter(/databases/$(database)/documents/stories/$(storyId)/views/$(request.auth.uid))
        )
      );
      allow delete: if isValidId(storyId) && isSignedIn() && (existing().authorId == request.auth.uid || isAdmin());

      match /views/{userId} {
        allow get: if isValidId(storyId) && isValidId(userId) && isSignedIn();
        allow list: if isValidId(storyId) && isSignedIn();
        allow create: if isValidId(storyId) && isValidId(userId)
          && canAct()
          && request.auth.uid == userId
          && isValidStoryView(incoming())
          && incoming().userId == request.auth.uid
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/stories/$(storyId))
          && getAfter(/databases/$(database)/documents/stories/$(storyId)).data.viewsCount == get(/databases/$(database)/documents/stories/$(storyId)).data.viewsCount + 1;
      }
    }

    match /marketplace/{listingId} {
      allow get: if isValidId(listingId) && isSignedIn() && (resource == null || existing().status != 'removed' || existing().sellerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.status != 'removed' || resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isValidId(listingId)
        && canAct()
        && isValidMarketplaceListing(incoming())
        && incoming().sellerId == request.auth.uid
        && incoming().status == 'available'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(listingId) && isSignedIn() && isValidMarketplaceListing(incoming()) && (
        isAdmin() ||
        (
          canAct()
          && existing().sellerId == request.auth.uid
          && existing().status != 'removed'
          && incoming().sellerId == existing().sellerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'priceCents', 'category', 'condition', 'location',
            'description', 'imageURL', 'status', 'updatedAt'
          ])
        )
      );
      allow delete: if isValidId(listingId) && isSignedIn() && (existing().sellerId == request.auth.uid || isAdmin());
    }

    match /events/{eventId} {
      allow get: if isValidId(eventId) && isSignedIn() && (resource == null || existing().status == 'active' || existing().hostId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.status == 'active' || resource.data.hostId == request.auth.uid || isAdmin());
      allow create: if isValidId(eventId)
        && canAct()
        && isValidSocialEvent(incoming())
        && incoming().hostId == request.auth.uid
        && incoming().goingCount == 1
        && incoming().interestedCount == 0
        && incoming().status == 'active'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (incoming().contextType == 'personal' && incoming().contextId == '') ||
          (
            incoming().contextType == 'page'
            && isValidId(incoming().contextId)
            && exists(/databases/$(database)/documents/pages/$(incoming().contextId))
            && canPublishPageContent(incoming().contextId, getPageDoc(incoming().contextId))
          )
        );
      allow update: if isValidId(eventId) && isSignedIn() && isValidSocialEvent(incoming()) && (
        isAdmin() ||
        (
          canAct()
          && existing().status == 'active'
          && incoming().hostId == existing().hostId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (
              existing().hostId == request.auth.uid
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'title', 'description', 'category', 'location', 'isOnline',
                'eventDate', 'coverURL', 'status', 'updatedAt'
              ])
            ) ||
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['goingCount', 'interestedCount', 'updatedAt'])
              && incoming().goingCount >= 0
              && incoming().interestedCount >= 0
              && incoming().goingCount <= existing().goingCount + 1
              && incoming().goingCount >= existing().goingCount - 1
              && incoming().interestedCount <= existing().interestedCount + 1
              && incoming().interestedCount >= existing().interestedCount - 1
            )
          )
        )
      );
      allow delete: if isValidId(eventId) && isSignedIn() && (existing().hostId == request.auth.uid || isAdmin());

      match /rsvps/{userId} {
        allow get: if isValidId(eventId) && isValidId(userId) && isSignedIn();
        allow list: if isValidId(eventId) && isSignedIn();
        allow create, update: if isValidId(eventId) && isValidId(userId)
          && canAct()
          && request.auth.uid == userId
          && isValidEventRsvp(incoming())
          && incoming().userId == request.auth.uid
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/events/$(eventId));
        allow delete: if isValidId(eventId) && isValidId(userId)
          && canAct()
          && request.auth.uid == userId;
      }
    }

    match /ads/{adId} {
      allow get: if isValidId(adId) && isSignedIn() && (resource == null || existing().status == 'active' || isAdmin());
      allow list: if isSignedIn() && (resource.data.status == 'active' || isAdmin());
      allow create: if isValidId(adId)
        && isAdmin()
        && isValidAdCampaign(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().impressionsCount == 0
        && incoming().clicksCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(adId) && isSignedIn() && isValidAdCampaign(incoming()) && (
        isAdmin() ||
        (
          isAuthenticatedActive()
          && existing().status == 'active'
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['impressionsCount', 'updatedAt'])
              && incoming().impressionsCount == existing().impressionsCount + 1
            ) ||
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['clicksCount', 'updatedAt'])
              && incoming().clicksCount == existing().clicksCount + 1
            )
          )
        )
      );
      allow delete: if isValidId(adId) && isAdmin();

      match /events/{eventId} {
        allow get: if isValidId(adId) && isValidId(eventId) && isAdmin();
        allow list: if isValidId(adId) && isAdmin();
        allow create: if isValidId(adId) && isValidId(eventId)
          && isAuthenticatedActive()
          && isValidAdEvent(incoming())
          && incoming().userId == request.auth.uid
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/ads/$(adId));
        allow update, delete: if false;
      }
    }

    match /advertiser_accounts/{uid} {
      allow get: if isValidId(uid) && isSignedIn() && (isOwner(uid) || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(uid)
        && isAdmin()
        && isValidAdvertiserAccount(incoming())
        && incoming().uid == uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(uid)
        && isAdmin()
        && isValidAdvertiserAccount(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(uid) && isAdmin();
    }

    match /boost_requests/{boostId} {
      allow get: if isValidId(boostId) && isSignedIn() && (resource == null || existing().requesterId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.requesterId == request.auth.uid || isAdmin());
      allow create: if isValidId(boostId)
        && isAuthenticatedActive()
        && isValidBoostRequest(incoming())
        && incoming().requesterId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().adminNote == ''
        && incoming().impressionsCount == 0
        && incoming().clicksCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(boostId) && isSignedIn() && isValidBoostRequest(incoming()) && (
        isAdmin() ||
        (
          isAuthenticatedActive()
          && existing().requesterId == request.auth.uid
          && existing().status in ['pending', 'approved']
          && incoming().status == 'cancelled'
          && incoming().requesterId == existing().requesterId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        )
      );
      allow delete: if isValidId(boostId) && isAdmin();
    }

    match /admin_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(logId)
        && isAdmin()
        && isValidAdminAuditLog(incoming())
        && incoming().adminId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
