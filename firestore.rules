    function isValidAdCampaign(data) {
      return data.keys().hasAll([
          'advertiserId', 'advertiserName', 'title', 'description', 'mediaType', 'mediaURL',
          'destinationURL', 'ctaLabel', 'placement', 'targetAudience', 'budgetCents', 'dailyLimitCents',
          'spentCents', 'startDate', 'endDate', 'impressionsCount', 'clicksCount', 'status',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'advertiserId', 'advertiserName', 'title', 'description', 'mediaType', 'mediaURL', 'mediaPath', 'thumbnailURL', 'thumbnailPath',
          'destinationURL', 'ctaLabel', 'placement', 'targetAudience', 'budgetCents', 'dailyLimitCents',
          'spentCents', 'startDate', 'endDate', 'impressionsCount', 'clicksCount', 'status',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.advertiserId)
        && data.advertiserName is string && data.advertiserName.size() >= 1 && data.advertiserName.size() <= 80
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 100
        && data.description is string && data.description.size() <= 500
        && data.mediaType in ['image', 'video']
        && data.mediaURL is string && data.mediaURL.size() >= 1 && data.mediaURL.size() <= 350000
        && (!('mediaPath' in data) || isValidStoragePath(data.mediaPath))
        && (!('thumbnailURL' in data) || (data.thumbnailURL is string && data.thumbnailURL.size() <= 350000))
        && (!('thumbnailPath' in data) || isValidStoragePath(data.thumbnailPath))
        && data.destinationURL is string && data.destinationURL.size() >= 4 && data.destinationURL.size() <= 2048
        && data.ctaLabel is string && data.ctaLabel.size() >= 1 && data.ctaLabel.size() <= 40
        && data.placement in ['feed', 'watch', 'reels', 'sidebar']
        && data.targetAudience is string && data.targetAudience.size() <= 200
        && data.budgetCents is int && data.budgetCents >= 0
        && data.dailyLimitCents is int && data.dailyLimitCents >= 0
        && data.spentCents is int && data.spentCents >= 0
        && data.startDate is string && data.startDate.size() <= 40
        && data.endDate is string && data.endDate.size() <= 40
        && data.impressionsCount is int && data.impressionsCount >= 0
        && data.clicksCount is int && data.clicksCount >= 0
        && data.status in ['active', 'paused', 'stopped']
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdEvent(data) {
      return data.keys().hasAll(['userId', 'eventType', 'createdAt'])
        && data.keys().hasOnly(['userId', 'eventType', 'createdAt'])
        && isValidId(data.userId)
        && data.eventType in ['impression', 'click']
        && data.createdAt is timestamp;
    }

    function isValidAdvertiserAccount(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'username', 'companyName', 'contactEmail',
          'status', 'totalBudgetCents', 'totalSpentCents', 'campaignsCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'username', 'companyName', 'contactEmail',
          'status', 'totalBudgetCents', 'totalSpentCents', 'campaignsCount', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60
        && data.username is string && data.username.size() >= 3 && data.username.size() <= 24
        && data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 80
        && data.contactEmail is string && data.contactEmail.size() <= 254
        && data.status in ['active', 'suspended']
        && data.totalBudgetCents is int && data.totalBudgetCents >= 0
        && data.totalSpentCents is int && data.totalSpentCents >= 0
        && data.campaignsCount is int && data.campaignsCount >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBoostRequest(data) {
      return data.keys().hasAll([
          'requesterId', 'requesterName', 'requesterUsername', 'targetType', 'targetId',
          'mediaType', 'contentPreview', 'mediaURL', 'contextType', 'contextId',
          'targetAudience', 'durationDays', 'budgetCents', 'impressionsCount', 'clicksCount',
          'status', 'adminNote', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'requesterId', 'requesterName', 'requesterUsername', 'targetType', 'targetId',
          'mediaType', 'contentPreview', 'mediaURL', 'mediaPath', 'contextType', 'contextId',
          'targetAudience', 'durationDays', 'budgetCents', 'impressionsCount', 'clicksCount',
          'status', 'adminNote', 'reviewedBy', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.requesterId)
        && data.requesterName is string && data.requesterName.size() >= 1 && data.requesterName.size() <= 60
        && data.requesterUsername is string && data.requesterUsername.size() >= 3 && data.requesterUsername.size() <= 24
        && data.targetType in ['post', 'reel']
        && isValidId(data.targetId)
        && data.mediaType in ['none', 'image', 'video']
        && data.contentPreview is string && data.contentPreview.size() <= 240
        && data.mediaURL is string && data.mediaURL.size() <= 350000
        && (!('mediaPath' in data) || isValidStoragePath(data.mediaPath))
        && data.contextType in ['personal', 'page']
        && data.contextId is string && data.contextId.size() <= 128
        && data.targetAudience is string && data.targetAudience.size() >= 2 && data.targetAudience.size() <= 200
        && data.durationDays is int && data.durationDays >= 1 && data.durationDays <= 365
        && data.budgetCents is int && data.budgetCents >= 100
        && data.impressionsCount is int && data.impressionsCount >= 0
        && data.clicksCount is int && data.clicksCount >= 0
        && data.status in ['pending', 'approved', 'rejected', 'paused', 'cancelled']
        && data.adminNote is string && data.adminNote.size() <= 400
        && (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminAuditLog(data) {
      return data.keys().hasAll([
          'adminId', 'adminName', 'adminEmail', 'action', 'targetType',
          'targetId', 'targetLabel', 'details', 'createdAt'
        ])
        && data.keys().hasOnly([
          'adminId', 'adminName', 'adminEmail', 'action', 'targetType',
          'targetId', 'targetLabel', 'details', 'createdAt'
        ])
        && isValidId(data.adminId)
        && data.adminName is string && data.adminName.size() >= 1 && data.adminName.size() <= 60
        && data.adminEmail is string && data.adminEmail.size() <= 254
        && data.action is string && data.action.size() >= 2 && data.action.size() <= 80
        && data.targetType in ['user', 'post', 'reel', 'page', 'group', 'report', 'monetization', 'payout', 'ad', 'advertiser', 'boost', 'config', 'admin']
        && isValidId(data.targetId)
        && data.targetLabel is string && data.targetLabel.size() >= 1 && data.targetLabel.size() <= 120
        && data.details is string && data.details.size() >= 1 && data.details.size() <= 400
        && data.createdAt is timestamp;
    }

    // --- Collection Rules ---

    match /users_public/{userId} {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if isSignedIn() && (resource.data.accountStatus == 'active' || resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserPublic(incoming())
        && incoming().uid == request.auth.uid
        && incoming().followersCount == 0
        && incoming().followingCount == 0
        && (!('friendsCount' in incoming()) || incoming().friendsCount == 0)
        && incoming().postsCount == 0
        && incoming().isVerifiedCreator == false
        && incoming().monetizationStatus == 'none'
        && incoming().accountStatus == 'active'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId) && isSignedIn() && (
        (
          isOwner(userId)
          && isAuthenticatedActive()
          && isValidUserPublic(incoming())
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'username', 'bio', 'photoURL', 'coverURL', 'location', 'website',
            'work', 'education', 'hometown', 'relationshipStatus',
            'profileVisibility', 'defaultPostVisibility', 'defaultReelVisibility',
            'allowMessagesFrom', 'allowFriendRequestsFrom', 'allowCommentsFrom', 'allowTagging',
            'showConnections', 'showOnlineStatus', 'allowSearchDiscovery',
            'updatedAt'
          ])
        ) ||
        (
          isOwner(userId)
          && isVerified()
          && (isMaintenanceOff() || isAdmin())
          && isValidUserPublic(incoming())
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && existing().accountStatus in ['active', 'deactivated']
          && incoming().accountStatus in ['active', 'deactivated']
          && incoming().diff(existing()).affectedKeys().hasOnly(['accountStatus', 'updatedAt'])
        ) ||
        (
          isOwner(userId)
          && canAct()
          && (!('uid' in existing()) || incoming().uid == existing().uid)
          && (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt)
          && incoming().updatedAt == request.time
          && incoming().postsCount is int && incoming().postsCount >= 0
          && incoming().diff(existing()).affectedKeys().hasOnly(['postsCount', 'updatedAt'])
          && (
            incoming().postsCount == userPostsCount(existing()) + 1 ||
            (userPostsCount(existing()) > 0 && incoming().postsCount == userPostsCount(existing()) - 1)
          )
        ) ||
        (
          isAuthenticatedActive()
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().followersCount is int && incoming().followersCount >= 0
          && incoming().diff(existing()).affectedKeys().hasOnly(['followersCount', 'updatedAt'])
          && (
            (incoming().followersCount == userFollowersCount(existing()) + 1 && existsAfter(/databases/$(database)/documents/users_public/$(userId)/followers/$(request.auth.uid))) ||
            (incoming().followersCount == (userFollowersCount(existing()) > 0 ? userFollowersCount(existing()) - 1 : 0) && !existsAfter(/databases/$(database)/documents/users_public/$(userId)/followers/$(request.auth.uid)))
          )
        ) ||
        (
          isOwner(userId)
          && isAuthenticatedActive()
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().followingCount is int && incoming().followingCount >= 0
          && incoming().diff(existing()).affectedKeys().hasOnly(['followingCount', 'updatedAt'])
          && (
            incoming().followingCount == userFollowingCount(existing()) + 1 ||
            (userFollowingCount(existing()) > 0 && incoming().followingCount == userFollowingCount(existing()) - 1)
          )
        ) ||
        (
          isAuthenticatedActive()
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().friendsCount is int && incoming().friendsCount >= 0
          && incoming().diff(existing()).affectedKeys().hasOnly(['friendsCount', 'updatedAt'])
          && (
            (
              isOwner(userId)
              && (
                incoming().friendsCount == userFriendsCount(existing()) + 1 ||
                (userFriendsCount(existing()) > 0 && incoming().friendsCount == userFriendsCount(existing()) - 1)
              )
            ) ||
            (
              !isOwner(userId)
              && (
                (
                  incoming().friendsCount == userFriendsCount(existing()) + 1
                  && !exists(/databases/$(database)/documents/users_public/$(userId)/friends/$(request.auth.uid))
                  && existsAfter(/databases/$(database)/documents/users_public/$(userId)/friends/$(request.auth.uid))
                ) ||
                (
                  incoming().friendsCount == (userFriendsCount(existing()) > 0 ? userFriendsCount(existing()) - 1 : 0)
                  && exists(/databases/$(database)/documents/users_public/$(userId)/friends/$(request.auth.uid))
                  && !existsAfter(/databases/$(database)/documents/users_public/$(userId)/friends/$(request.auth.uid))
                )
              )
            )
          )
        ) ||
        (isAdmin() && isValidUserPublic(incoming()))
      );

      allow delete: if isValidId(userId) && isAdmin();

      match /followers/{followerId} {
        allow get: if isValidId(userId) && isValidId(followerId) && isSignedIn();
        allow list: if isValidId(userId) && isSignedIn();
        allow create: if isValidId(userId) && isValidId(followerId)
          && isAuthenticatedActive()
          && request.auth.uid == followerId
          && userId != followerId
          && isValidFollowEdge(incoming())
          && incoming().uid == request.auth.uid
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users_public/$(userId))
          && getAfter(/databases/$(database)/documents/users_public/$(userId)).data.followersCount == userFollowersCount(get(/databases/$(database)/documents/users_public/$(userId)).data) + 1;
        allow delete: if isValidId(userId) && isValidId(followerId)
          && isAuthenticatedActive()
          && request.auth.uid == followerId
          && getAfter(/databases/$(database)/documents/users_public/$(userId)).data.followersCount == (userFollowersCount(get(/databases/$(database)/documents/users_public/$(userId)).data) > 0 ? userFollowersCount(get(/databases/$(database)/documents/users_public/$(userId)).data) - 1 : 0);
      }

      match /following/{targetId} {
        allow get: if isValidId(userId) && isValidId(targetId) && isSignedIn();
        allow list: if isValidId(userId) && isSignedIn();
        allow create: if isValidId(userId) && isValidId(targetId)
          && isAuthenticatedActive()
          && request.auth.uid == userId
          && userId != targetId
          && isValidFollowEdge(incoming())
          && incoming().uid == targetId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users_public/$(targetId))
          && existsAfter(/databases/$(database)/documents/users_public/$(targetId)/followers/$(userId));
        allow delete: if isValidId(userId) && isValidId(targetId)
          && isAuthenticatedActive()
          && request.auth.uid == userId
          && !existsAfter(/databases/$(database)/documents/users_public/$(targetId)/followers/$(userId));
      }

      match /following_pages/{pageId} {
        allow get: if isValidId(userId) && isValidId(pageId) && isSignedIn();
        allow list: if isValidId(userId) && isSignedIn();
        allow create: if isValidId(userId) && isValidId(pageId)
          && isAuthenticatedActive()
          && request.auth.uid == userId
          && isValidPageFollowEdge(incoming())
          && incoming().pageId == pageId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/pages/$(pageId))
          && existsAfter(/databases/$(database)/documents/pages/$(pageId)/followers/$(userId));
        allow delete: if isValidId(userId) && isValidId(pageId)
          && isAuthenticatedActive()
          && request.auth.uid == userId
          && !existsAfter(/databases/$(database)/documents/pages/$(pageId)/followers/$(userId));
      }

      match /friends/{friendId} {
        allow get: if isValidId(userId) && isValidId(friendId) && isSignedIn();
        allow list: if isValidId(userId) && isSignedIn();
        allow create: if isValidId(userId) && isValidId(friendId)
          && isAuthenticatedActive()
          && userId != friendId
          && (request.auth.uid == userId || request.auth.uid == friendId)
          && isValidFollowEdge(incoming())
          && incoming().uid == friendId
          && incoming().createdAt == request.time
          && getAfter(/databases/$(database)/documents/friend_requests/$(sortedPairId(userId, friendId))).data.status == 'accepted'
          && (
            reqReceiver(get(/databases/$(database)/documents/friend_requests/$(sortedPairId(userId, friendId))).data) == request.auth.uid ||
            get(/databases/$(database)/documents/friend_requests/$(sortedPairId(userId, friendId))).data.status == 'accepted'
          );
        allow delete: if isValidId(userId) && isValidId(friendId)
          && isSignedIn()
          && (request.auth.uid == userId || request.auth.uid == friendId)
          && !existsAfter(/databases/$(database)/documents/friend_requests/$(sortedPairId(userId, friendId)));
      }

      match /page_invites/{pageId} {
        allow get: if isValidId(userId) && isValidId(pageId) && isSignedIn() && (resource == null || isOwner(userId) || existing().invitedById == request.auth.uid);
        allow list: if isValidId(userId) && isSignedIn() && isOwner(userId) && resource.data.inviteeId == userId;
        allow create: if isValidId(userId) && isValidId(pageId)
          && isAuthenticatedActive()
          && isValidPageInvitation(incoming())
          && incoming().inviteeId == userId
          && incoming().pageId == pageId
          && incoming().invitedById == request.auth.uid
          && incoming().status == 'pending'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && canManagePageMembers(pageId, getPageDoc(pageId));
        allow update: if isValidId(userId) && isValidId(pageId)
          && isAuthenticatedActive()
          && isValidPageInvitation(incoming())
          && incoming().pageId == existing().pageId
          && incoming().inviteeId == existing().inviteeId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (
              isOwner(userId)
              && existing().status == 'pending'
              && incoming().status in ['accepted', 'declined']
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
            ) ||
            (
              incoming().invitedById == request.auth.uid
              && canManagePageMembers(pageId, getPageDoc(pageId))
            )
          );
        allow delete: if isValidId(userId) && isValidId(pageId) && isSignedIn() && (
          isOwner(userId) || canManagePageMembers(pageId, getPageDoc(pageId))
        );
      }

      match /saved_posts/{itemId} {
        allow get: if isValidId(userId) && isValidId(itemId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(itemId)
          && canAct()
          && isOwner(userId)
          && isValidSavedPostItem(incoming())
          && incoming().itemId == itemId
          && incoming().createdAt == request.time;
        allow delete: if isValidId(userId) && isValidId(itemId) && isOwner(userId);
      }

      match /activity_logs/{activityId} {
        allow get: if isValidId(userId) && isValidId(activityId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow create: if isValidId(userId) && isValidId(activityId)
          && canAct()
          && isOwner(userId)
          && isValidUserActivityLog(incoming())
          && incoming().userId == request.auth.uid
          && incoming().createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /users_private/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserPrivate(incoming())
        && incoming().uid == request.auth.uid
        && incoming().totalEarningsCents == 0
        && incoming().pendingPayoutCents == 0
        && (!('createdAt' in incoming()) || incoming().createdAt == request.time)
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isSignedIn() && isValidUserPrivate(incoming()) && (
        isAdmin() ||
        (
          isOwner(userId)
          && canAct()
          && incoming().uid == existing().uid
          && incoming().email == existing().email
          && (!('verifiedContactType' in existing()) || incoming().verifiedContactType == existing().verifiedContactType)
          && (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt)
          && incoming().totalEarningsCents == existing().totalEarningsCents
          && incoming().pendingPayoutCents == existing().pendingPayoutCents
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'phone', 'birthYear', 'payoutMethodNote',
            'firstName', 'lastName', 'gender', 'birthDate',
            'twoFactorEnabled', 'loginAlerts', 'autoplayMedia', 'dataSaverMode',
            'notifLikes', 'notifComments', 'notifFriends', 'notifMessages', 'notifPagesGroups',
            'adPersonalization',
            'updatedAt'
          ])
        )
      );
      allow delete: if isValidId(userId) && isAdmin();

      match /blocked/{blockedUid} {
        allow get: if isValidId(userId) && isValidId(blockedUid) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(blockedUid)
          && isOwner(userId)
          && userId != blockedUid
          && canAct()
          && isValidBlockedUser(incoming())
          && incoming().uid == blockedUid
          && incoming().createdAt == request.time;
        allow delete: if isValidId(userId) && isValidId(blockedUid) && isOwner(userId);
      }

      match /restricted/{targetUid} {
        allow get: if isValidId(userId) && isValidId(targetUid) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(targetUid)
          && isOwner(userId)
          && userId != targetUid
          && canAct()
          && isValidRestrictedUser(incoming())
          && incoming().uid == targetUid
          && incoming().createdAt == request.time;
        allow delete: if isValidId(userId) && isValidId(targetUid) && isOwner(userId);
      }
    }

    match /posts/{postId} {
      allow get: if isValidId(postId) && isSignedIn() && (resource == null || existing().status == 'active' || existing().authorId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.status == 'active' || resource.data.authorId == request.auth.uid || isAdmin());
      allow create: if isValidId(postId)
        && canAct()
        && isValidPost(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().likesCount == 0
        && incoming().commentsCount == 0
        && incoming().sharesCount == 0
        && incoming().viewsCount == 0
        && !('adminLikesOffset' in incoming())
        && !('adminCommentsOffset' in incoming())
        && !('adminSharesOffset' in incoming())
        && !('adminViewsOffset' in incoming())
        && !('engagementDisabled' in incoming())
        && !('engagementLimit' in incoming())
        && !('isBoosted' in incoming())
        && !('activeBoostId' in incoming())
        && (
          incoming().status == 'active' ||
          (incoming().status == 'scheduled' && 'scheduledAt' in incoming() && incoming().scheduledAt is timestamp)
        )
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (incoming().contextType == 'feed' && incoming().contextId == '') ||
          (
            incoming().contextType == 'page'
            && isValidId(incoming().contextId)
            && exists(/databases/$(database)/documents/pages/$(incoming().contextId))
            && canPublishPageContent(incoming().contextId, getPageDoc(incoming().contextId))
          ) ||
          (incoming().contextType == 'group' && isValidId(incoming().contextId) && exists(/databases/$(database)/documents/groups/$(incoming().contextId)/members/$(request.auth.uid)))
        );

      allow update: if isValidId(postId) && isSignedIn() && isValidPost(incoming()) && (
        isAdmin() ||
        (
          canAct()
          && existing().status in ['active', 'scheduled']
          && incoming().authorId == existing().authorId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (
              (
                (existing().contextType != 'page' && incoming().authorId == request.auth.uid) ||
                (
                  existing().contextType == 'page'
                  && isValidId(existing().contextId)
                  && exists(/databases/$(database)/documents/pages/$(existing().contextId))
                  && (
                    canDeleteAnyPageContent(existing().contextId, getPageDoc(existing().contextId)) ||
                    (
                      existing().authorId == request.auth.uid
                      && canPublishPageContent(existing().contextId, getPageDoc(existing().contextId))
                    )
                  )
                )
              )
              && (
                incoming().status == existing().status ||
                (existing().status == 'scheduled' && incoming().status == 'active')
              )
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'content', 'mediaType', 'mediaURL', 'mediaPath', 'mediaURLs', 'thumbnailURL', 'thumbnailPath', 'hashtags',
                'visibility', 'feeling', 'locationTag', 'bgStyle', 'isPinned', 'status', 'scheduledAt', 'updatedAt'
              ])
            ) ||
            (
              existing().status == 'active'
              && (!('engagementDisabled' in existing()) || existing().engagementDisabled == false)
              && (
                (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'reactionCounts', 'updatedAt']) && (
                  (incoming().likesCount == existing().likesCount + 1 && existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))) ||
                  (incoming().likesCount == existing().likesCount - 1 && !existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))) ||
                  (incoming().likesCount == existing().likesCount && existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid)))
                )) ||
                (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt']) && (
