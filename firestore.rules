rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Security Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isVerified() {
      return isSignedIn();
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isBootstrapAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'adnanleghari383@gmail.com' ||
        request.auth.token.email == 'latifleghari25@gmail.com' ||
        request.auth.token.email == 'kl3961463@gmail.com'
      );
    }

    function isAdmin() {
      return isBootstrapAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isMaintenanceOff() {
      return !exists(/databases/$(database)/documents/platform_config/global)
        || get(/databases/$(database)/documents/platform_config/global).data.maintenanceMode == false;
    }

    function isActiveAccount() {
      return !exists(/databases/$(database)/documents/users_public/$(request.auth.uid))
        || !('accountStatus' in get(/databases/$(database)/documents/users_public/$(request.auth.uid)).data)
        || get(/databases/$(database)/documents/users_public/$(request.auth.uid)).data.accountStatus == 'active';
    }

    function canAct() {
      return isVerified() && isActiveAccount() && (isMaintenanceOff() || isAdmin());
    }

    function isAuthenticatedActive() {
      return isSignedIn() && isActiveAccount() && (isMaintenanceOff() || isAdmin());
    }

    function userFriendsCount(data) {
      return ('friendsCount' in data && data.friendsCount is int) ? data.friendsCount : 0;
    }

    function userFollowersCount(data) {
      return ('followersCount' in data && data.followersCount is int) ? data.followersCount : 0;
    }

    function userFollowingCount(data) {
      return ('followingCount' in data && data.followingCount is int) ? data.followingCount : 0;
    }

    function userPostsCount(data) {
      return ('postsCount' in data && data.postsCount is int) ? data.postsCount : 0;
    }

    function pageFollowersCount(data) {
      return ('followersCount' in data && data.followersCount is int) ? data.followersCount : 0;
    }

    function commentLikesCount(data) {
      return ('likesCount' in data && data.likesCount is int) ? data.likesCount : 0;
    }

    function reqSender(data) {
      return ('senderId' in data && data.senderId is string) ? data.senderId : data.fromId;
    }

    function reqReceiver(data) {
      return ('receiverId' in data && data.receiverId is string) ? data.receiverId : data.toId;
    }

    function sortedPairId(uidA, uidB) {
      return uidA < uidB ? uidA + '_' + uidB : uidB + '_' + uidA;
    }

    // --- Page Access RBAC Helpers ---
    function pageOrigOwnerId(pageData) {
      return ('originalOwnerId' in pageData && pageData.originalOwnerId is string && pageData.originalOwnerId.size() > 0)
        ? pageData.originalOwnerId
        : pageData.ownerId;
    }

    function isPageOriginalOwner(pageData) {
      return isSignedIn() && (pageData.ownerId == request.auth.uid || pageOrigOwnerId(pageData) == request.auth.uid);
    }

    function getPageDoc(pageId) {
      return get(/databases/$(database)/documents/pages/$(pageId)).data;
    }

    function hasPageMember(pageId) {
      return isSignedIn() && exists(/databases/$(database)/documents/pages/$(pageId)/members/$(request.auth.uid));
    }

    function getPageMember(pageId) {
      return get(/databases/$(database)/documents/pages/$(pageId)/members/$(request.auth.uid)).data;
    }

    function isActivePageMember(pageId) {
      return hasPageMember(pageId) && getPageMember(pageId).status == 'active';
    }

    function isPageActiveMemberOrOwner(pageId, pageData) {
      return isPageOriginalOwner(pageData) || isActivePageMember(pageId);
    }

    function canEditPageSettings(pageId, pageData) {
      return isPageOriginalOwner(pageData) || (
        isActivePageMember(pageId) && getPageMember(pageId).role in ['owner', 'admin']
      );
    }

    function canPublishPageContent(pageId, pageData) {
      return pageData.status == 'active' && (
        isPageOriginalOwner(pageData) || (
          isActivePageMember(pageId) && getPageMember(pageId).role in ['owner', 'admin', 'editor']
        )
      );
    }

    function canDeleteAnyPageContent(pageId, pageData) {
      return isPageOriginalOwner(pageData) || (
        isActivePageMember(pageId) && getPageMember(pageId).role in ['owner', 'admin']
      );
    }

    function canModeratePageComments(pageId, pageData) {
      return isPageOriginalOwner(pageData) || (
        isActivePageMember(pageId) && getPageMember(pageId).role in ['owner', 'admin', 'moderator']
      );
    }

    function canManagePageMembers(pageId, pageData) {
      return isPageOriginalOwner(pageData) || (
        isActivePageMember(pageId)
        && getPageMember(pageId).role == 'admin'
        && getPageMember(pageId).canManageMembers == true
      );
    }

    // --- Validation Blueprints ---
    function isValidUserPublic(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'username', 'bio', 'photoURL', 'coverURL',
          'location', 'website', 'followersCount', 'followingCount', 'postsCount',
          'isVerifiedCreator', 'monetizationStatus', 'accountStatus', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'username', 'bio', 'photoURL', 'coverURL',
          'location', 'website', 'work', 'education', 'hometown', 'relationshipStatus',
          'followersCount', 'followingCount', 'friendsCount', 'postsCount',
          'isVerifiedCreator', 'monetizationStatus', 'accountStatus',
          'profileVisibility', 'defaultPostVisibility', 'defaultReelVisibility',
          'allowMessagesFrom', 'allowFriendRequestsFrom', 'allowCommentsFrom', 'allowTagging',
          'showConnections', 'showOnlineStatus', 'allowSearchDiscovery',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 60
        && data.username is string && data.username.size() >= 3 && data.username.size() <= 24 && data.username.matches('^[a-z0-9_]+$')
        && data.bio is string && data.bio.size() <= 280
        && data.photoURL is string && data.photoURL.size() <= 2048
        && data.coverURL is string && data.coverURL.size() <= 2048
        && data.location is string && data.location.size() <= 80
        && data.website is string && data.website.size() <= 200
        && (!('work' in data) || (data.work is string && data.work.size() <= 100))
        && (!('education' in data) || (data.education is string && data.education.size() <= 100))
        && (!('hometown' in data) || (data.hometown is string && data.hometown.size() <= 80))
        && (!('relationshipStatus' in data) || (data.relationshipStatus is string && data.relationshipStatus.size() <= 40))
        && data.followersCount is int && data.followersCount >= 0
        && data.followingCount is int && data.followingCount >= 0
        && (!('friendsCount' in data) || (data.friendsCount is int && data.friendsCount >= 0))
        && data.postsCount is int && data.postsCount >= 0
        && data.isVerifiedCreator is bool
        && data.monetizationStatus in ['none', 'pending', 'approved', 'rejected']
        && data.accountStatus in ['active', 'suspended', 'deactivated', 'deleted']
        && (!('profileVisibility' in data) || data.profileVisibility in ['public', 'friends'])
        && (!('defaultPostVisibility' in data) || data.defaultPostVisibility in ['public', 'friends', 'only_me'])
        && (!('defaultReelVisibility' in data) || data.defaultReelVisibility in ['public', 'friends'])
        && (!('allowMessagesFrom' in data) || data.allowMessagesFrom in ['everyone', 'friends'])
        && (!('allowFriendRequestsFrom' in data) || data.allowFriendRequestsFrom in ['everyone', 'friends_of_friends'])
        && (!('allowCommentsFrom' in data) || data.allowCommentsFrom in ['everyone', 'friends'])
        && (!('allowTagging' in data) || data.allowTagging in ['everyone', 'friends', 'none'])
        && (!('showConnections' in data) || data.showConnections is bool)
        && (!('showOnlineStatus' in data) || data.showOnlineStatus is bool)
        && (!('allowSearchDiscovery' in data) || data.allowSearchDiscovery is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBlockedUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'username', 'photoURL', 'createdAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'username', 'photoURL', 'createdAt'])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60
        && data.username is string && data.username.size() >= 3 && data.username.size() <= 24 && data.username.matches('^[a-z0-9_]+$')
        && data.photoURL is string && data.photoURL.size() <= 2048
        && data.createdAt is timestamp;
    }

    function isValidUserPrivate(data) {
      return data.keys().hasAll([
          'uid', 'email', 'phone', 'birthYear', 'payoutMethodNote',
          'totalEarningsCents', 'pendingPayoutCents', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'phone', 'firstName', 'lastName', 'gender',
          'birthDate', 'verifiedContactType', 'birthYear', 'payoutMethodNote',
          'twoFactorEnabled', 'loginAlerts', 'autoplayMedia', 'dataSaverMode',
          'notifLikes', 'notifComments', 'notifFriends', 'notifMessages', 'notifPagesGroups',
          'adPersonalization',
          'totalEarningsCents', 'pendingPayoutCents', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.email is string && data.email.size() <= 254
        && data.phone is string && data.phone.size() <= 32
        && (data.email.size() >= 3 || data.phone.size() >= 7)
        && (!('firstName' in data) || (data.firstName is string && data.firstName.size() >= 1 && data.firstName.size() <= 30))
        && (!('lastName' in data) || (data.lastName is string && data.lastName.size() >= 1 && data.lastName.size() <= 30))
        && (!('gender' in data) || data.gender in ['male', 'female'])
        && (!('birthDate' in data) || (data.birthDate is string && data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('verifiedContactType' in data) || data.verifiedContactType in ['email', 'phone'])
        && data.birthYear is string && data.birthYear.size() <= 10
        && data.payoutMethodNote is string && data.payoutMethodNote.size() <= 160
        && (!('twoFactorEnabled' in data) || data.twoFactorEnabled is bool)
        && (!('loginAlerts' in data) || data.loginAlerts is bool)
        && (!('autoplayMedia' in data) || data.autoplayMedia is bool)
        && (!('dataSaverMode' in data) || data.dataSaverMode is bool)
        && (!('notifLikes' in data) || data.notifLikes is bool)
        && (!('notifComments' in data) || data.notifComments is bool)
        && (!('notifFriends' in data) || data.notifFriends is bool)
        && (!('notifMessages' in data) || data.notifMessages is bool)
        && (!('notifPagesGroups' in data) || data.notifPagesGroups is bool)
        && (!('adPersonalization' in data) || data.adPersonalization is bool)
        && data.totalEarningsCents is int && data.totalEarningsCents >= 0
        && data.pendingPayoutCents is int && data.pendingPayoutCents >= 0
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && data.updatedAt is timestamp;
    }

    function isValidFollowEdge(data) {
      return data.keys().hasAll(['uid', 'displayName', 'username', 'photoURL', 'createdAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'username', 'photoURL', 'createdAt'])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60
        && data.username is string && data.username.size() >= 3 && data.username.size() <= 24 && data.username.matches('^[a-z0-9_]+$')
        && data.photoURL is string && data.photoURL.size() <= 2048
        && data.createdAt is timestamp;
    }

    function isValidPageFollowEdge(data) {
      return data.keys().hasAll(['pageId', 'name', 'handle', 'avatarURL', 'category', 'createdAt'])
        && data.keys().hasOnly(['pageId', 'name', 'handle', 'avatarURL', 'category', 'createdAt'])
        && isValidId(data.pageId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.handle is string && data.handle.size() >= 3 && data.handle.size() <= 30 && data.handle.matches('^[a-z0-9_]+$')
        && data.avatarURL is string && data.avatarURL.size() <= 2048
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 40
        && data.createdAt is timestamp;
    }

    function isValidReactionCounts(counts) {
      return counts is map
        && counts.keys().hasOnly(['like', 'love', 'care', 'haha', 'wow', 'sad', 'angry']);
    }

    function isValidStoragePath(path) {
      return path is string
        && path.size() <= 512
        && (
          path == '' ||
          path.matches('^users/[a-zA-Z0-9_\\-]+/(profile|cover|posts|pages|groups|story_photos|events|marketplace|ads|thumbnails|videos|reels|story_videos|ad_videos)/[a-zA-Z0-9._\\-]+$')
        );
    }

    function isValidPost(data) {
      return data.keys().hasAll([
          'authorId', 'authorName', 'authorUsername', 'authorPhotoURL',
          'content', 'mediaType', 'mediaURL', 'contextType', 'contextId',
          'likesCount', 'commentsCount', 'sharesCount', 'viewsCount',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'authorId', 'authorName', 'authorUsername', 'authorPhotoURL', 'authorIsVerified',
          'content', 'mediaType', 'mediaURL', 'mediaPath', 'mediaURLs', 'thumbnailURL', 'thumbnailPath', 'hashtags',
          'contextType', 'contextId',
          'likesCount', 'commentsCount', 'sharesCount', 'viewsCount',
          'adminLikesOffset', 'adminCommentsOffset', 'adminSharesOffset', 'adminViewsOffset',
          'engagementDisabled', 'engagementLimit', 'isBoosted', 'activeBoostId',
          'status', 'scheduledAt', 'visibility', 'feeling', 'locationTag', 'bgStyle',
          'isPinned', 'taggedUsers', 'pollQuestion', 'pollOptions',
          'reactionCounts', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60
        && data.authorUsername is string && data.authorUsername.size() >= 3 && data.authorUsername.size() <= 24 && data.authorUsername.matches('^[a-z0-9_]+$')
        && data.authorPhotoURL is string && data.authorPhotoURL.size() <= 2048
        && (!('authorIsVerified' in data) || data.authorIsVerified is bool)
        && data.content is string && data.content.size() <= 2000
        && data.mediaType in ['none', 'image', 'video']
        && data.mediaURL is string && data.mediaURL.size() <= 350000
        && (!('mediaPath' in data) || isValidStoragePath(data.mediaPath))
        && (!('mediaURLs' in data) || (data.mediaURLs is list && data.mediaURLs.size() <= 10))
        && (!('thumbnailURL' in data) || (data.thumbnailURL is string && data.thumbnailURL.size() <= 350000))
        && (!('thumbnailPath' in data) || isValidStoragePath(data.thumbnailPath))
        && (!('hashtags' in data) || (data.hashtags is list && data.hashtags.size() <= 20))
        && (
          data.content.size() > 0 ||
          data.mediaType != 'none' ||
          ('mediaURLs' in data && data.mediaURLs is list && data.mediaURLs.size() > 0) ||
          ('pollQuestion' in data && data.pollQuestion is string && data.pollQuestion.size() > 0)
        )
        && data.contextType in ['feed', 'page', 'group']
        && data.contextId is string && data.contextId.size() <= 128
        && data.likesCount is int && data.likesCount >= 0
        && data.commentsCount is int && data.commentsCount >= 0
        && data.sharesCount is int && data.sharesCount >= 0
        && data.viewsCount is int && data.viewsCount >= 0
        && (!('adminLikesOffset' in data) || data.adminLikesOffset is int)
        && (!('adminCommentsOffset' in data) || data.adminCommentsOffset is int)
        && (!('adminSharesOffset' in data) || data.adminSharesOffset is int)
        && (!('adminViewsOffset' in data) || data.adminViewsOffset is int)
        && (!('engagementDisabled' in data) || data.engagementDisabled is bool)
        && (!('engagementLimit' in data) || (data.engagementLimit is int && data.engagementLimit >= 0))
        && (!('isBoosted' in data) || data.isBoosted is bool)
        && (!('activeBoostId' in data) || (data.activeBoostId is string && data.activeBoostId.size() <= 128))
        && data.status in ['active', 'removed', 'scheduled']
        && (!('scheduledAt' in data) || data.scheduledAt is timestamp)
        && (!('visibility' in data) || data.visibility in ['public', 'friends', 'only_me'])
        && (!('feeling' in data) || (data.feeling is string && data.feeling.size() <= 60))
        && (!('locationTag' in data) || (data.locationTag is string && data.locationTag.size() <= 100))
        && (!('bgStyle' in data) || (data.bgStyle is string && data.bgStyle.size() <= 32))
        && (!('isPinned' in data) || data.isPinned is bool)
        && (!('taggedUsers' in data) || (data.taggedUsers is list && data.taggedUsers.size() <= 10))
        && (!('pollQuestion' in data) || (data.pollQuestion is string && data.pollQuestion.size() <= 200))
        && (!('pollOptions' in data) || (data.pollOptions is list && data.pollOptions.size() >= 2 && data.pollOptions.size() <= 4))
        && (!('reactionCounts' in data) || isValidReactionCounts(data.reactionCounts))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReel(data) {
      return data.keys().hasAll([
          'authorId', 'authorName', 'authorUsername', 'authorPhotoURL',
          'caption', 'videoURL', 'posterURL', 'visibility',
          'likesCount', 'commentsCount', 'sharesCount', 'viewsCount',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'authorId', 'authorName', 'authorUsername', 'authorPhotoURL',
          'caption', 'hashtags', 'videoURL', 'videoPath', 'posterURL', 'posterPath', 'contextType', 'contextId', 'visibility',
          'reactionCounts', 'likesCount', 'commentsCount', 'sharesCount', 'viewsCount',
          'adminLikesOffset', 'adminCommentsOffset', 'adminSharesOffset', 'adminViewsOffset',
          'engagementDisabled', 'engagementLimit', 'isBoosted', 'activeBoostId',
          'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.authorUsername is string && data.authorUsername.size() >= 3 && data.authorUsername.size() <= 30 && data.authorUsername.matches('^[a-z0-9_]+$')
        && data.authorPhotoURL is string && data.authorPhotoURL.size() <= 2048
        && data.caption is string && data.caption.size() <= 600
        && (!('hashtags' in data) || (data.hashtags is list && data.hashtags.size() <= 20))
        && data.videoURL is string && data.videoURL.size() <= 2048
        && (!('videoPath' in data) || isValidStoragePath(data.videoPath))
        && (data.videoURL.size() >= 1 || ('videoPath' in data && data.videoPath.size() > 0))
        && data.posterURL is string && data.posterURL.size() <= 2048
        && (!('posterPath' in data) || isValidStoragePath(data.posterPath))
        && (!('contextType' in data) || data.contextType in ['feed', 'page'])
        && (!('contextId' in data) || (data.contextId is string && data.contextId.size() <= 128))
        && data.visibility in ['public', 'friends']
        && (!('reactionCounts' in data) || isValidReactionCounts(data.reactionCounts))
        && data.likesCount is int && data.likesCount >= 0
        && data.commentsCount is int && data.commentsCount >= 0
        && data.sharesCount is int && data.sharesCount >= 0
        && data.viewsCount is int && data.viewsCount >= 0
        && (!('adminLikesOffset' in data) || data.adminLikesOffset is int)
        && (!('adminCommentsOffset' in data) || data.adminCommentsOffset is int)
        && (!('adminSharesOffset' in data) || data.adminSharesOffset is int)
        && (!('adminViewsOffset' in data) || data.adminViewsOffset is int)
        && (!('engagementDisabled' in data) || data.engagementDisabled is bool)
        && (!('engagementLimit' in data) || (data.engagementLimit is int && data.engagementLimit >= 0))
        && (!('isBoosted' in data) || data.isBoosted is bool)
        && (!('activeBoostId' in data) || (data.activeBoostId is string && data.activeBoostId.size() <= 128))
        && data.status in ['active', 'removed']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPostLike(data) {
      return data.keys().hasAll(['userId', 'createdAt'])
        && data.keys().hasOnly(['userId', 'reaction', 'userName', 'userPhotoURL', 'createdAt'])
        && isValidId(data.userId)
        && (!('reaction' in data) || data.reaction in ['like', 'love', 'care', 'haha', 'wow', 'sad', 'angry'])
        && (!('userName' in data) || (data.userName is string && data.userName.size() <= 60))
        && (!('userPhotoURL' in data) || (data.userPhotoURL is string && data.userPhotoURL.size() <= 2048))
        && data.createdAt is timestamp;
    }

    function isValidPollVote(data) {
      return data.keys().hasAll(['userId', 'optionId', 'createdAt'])
        && data.keys().hasOnly(['userId', 'optionId', 'createdAt'])
        && isValidId(data.userId)
        && data.optionId is string && data.optionId.size() >= 1 && data.optionId.size() <= 64
        && data.createdAt is timestamp;
    }

    function isValidSavedPostItem(data) {
      return data.keys().hasAll(['itemId', 'itemType', 'title', 'subtitle', 'authorName', 'mediaURL', 'createdAt'])
        && data.keys().hasOnly(['itemId', 'itemType', 'title', 'subtitle', 'authorName', 'mediaURL', 'mediaPath', 'createdAt'])
        && isValidId(data.itemId)
        && data.itemType in ['post', 'marketplace']
        && data.title is string && data.title.size() <= 160
        && data.subtitle is string && data.subtitle.size() <= 200
        && data.authorName is string && data.authorName.size() <= 80
        && data.mediaURL is string && data.mediaURL.size() <= 350000
        && (!('mediaPath' in data) || isValidStoragePath(data.mediaPath))
        && data.createdAt is timestamp;
    }

    function isValidStory(data) {
      return data.keys().hasAll([
          'authorId', 'authorName', 'authorUsername', 'authorPhotoURL',
          'contextType', 'contextId', 'mediaType', 'mediaURL', 'text',
          'bgStyle', 'visibility', 'viewsCount', 'status', 'expiresAt', 'createdAt'
        ])
        && data.keys().hasOnly([
          'authorId', 'authorName', 'authorUsername', 'authorPhotoURL',
          'contextType', 'contextId', 'mediaType', 'mediaURL', 'mediaPath', 'text',
          'bgStyle', 'visibility', 'viewsCount', 'status', 'expiresAt', 'createdAt'
        ])
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.authorUsername is string && data.authorUsername.size() >= 3 && data.authorUsername.size() <= 30
        && data.authorPhotoURL is string && data.authorPhotoURL.size() <= 2048
        && data.contextType in ['personal', 'page']
        && data.contextId is string && data.contextId.size() <= 128
        && data.mediaType in ['image', 'video', 'text']
        && data.mediaURL is string && data.mediaURL.size() <= 350000
        && (!('mediaPath' in data) || isValidStoragePath(data.mediaPath))
        && data.text is string && data.text.size() <= 300
        && data.bgStyle is string && data.bgStyle.size() <= 32
        && (data.mediaURL.size() > 0 || ('mediaPath' in data && data.mediaPath.size() > 0) || data.text.size() > 0)
        && data.visibility in ['public', 'friends']
        && data.viewsCount is int && data.viewsCount >= 0
        && data.status in ['active', 'removed']
        && data.expiresAt is timestamp
        && data.createdAt is timestamp;
    }

    function isValidStoryView(data) {
      return data.keys().hasAll(['userId', 'displayName', 'photoURL', 'createdAt'])
        && data.keys().hasOnly(['userId', 'displayName', 'photoURL', 'createdAt'])
        && isValidId(data.userId)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60
        && data.photoURL is string && data.photoURL.size() <= 2048
        && data.createdAt is timestamp;
    }

    function isValidMarketplaceListing(data) {
      return data.keys().hasAll([
          'sellerId', 'sellerName', 'sellerUsername', 'sellerPhotoURL',
          'title', 'priceCents', 'currency', 'category', 'condition',
          'location', 'description', 'imageURL', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
